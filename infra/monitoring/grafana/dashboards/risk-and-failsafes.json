{
  "uid": "td-risk-failsafes",
  "title": "Risk and Failsafes",
  "description": "Security failsafes that exist today. Trading risk controls are not built yet.",
  "tags": [
    "tradingdots"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read this first",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Read-only diagnostics.** These panels observe; nothing here can start, stop or change the bot, an exchange, a pair or any setting. Actions live in the main dashboard. Only metrics that exist are shown; components that are not built yet publish nothing, so there is no panel that would show an invented zero."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live trading",
      "description": "Compile-time constant; live trading is blocked in every build.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tradingdots_live_trading_blocked",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "BLOCKED",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "NOT BLOCKED",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
