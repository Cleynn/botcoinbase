    {
      "id": 11,
      "type": "table",
      "title": "Firing security alerts",
      "description": "Security alerts only.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
