    {
      "id": 15,
      "type": "timeseries",
      "title": "Container CPU (optional cAdvisor)",
      "description": "Requires the optional cadvisor compose profile; shows No data otherwise. Containers are identified by the first 12 characters of their id (`docker ps` shows the same).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\"}[5m]), \"container\", \"$2\", \"id\", \".*(docker-|/docker/)([0-9a-f]{12}).*\"))",
          "legendFormat": "{{container}}",
          "editorMode": "code"
