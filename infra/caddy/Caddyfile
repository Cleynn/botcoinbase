# Caddy is the only published service, on loopback 8080/444 behind the host's Apache (which owns the
# public 80/443, see infra/apache/tradingdots.conf). Hostnames come from the environment.
{
	admin off
	servers {
		protocols h1 h2
		# Apache reaches Caddy from the edge_public gateway (docker-compose.yml). Only that address
		# may supply X-Forwarded-For; it is read right to left so a client cannot prepend a fake one.
		trusted_proxies static 172.29.30.1/32
		trusted_proxies_strict
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=300"
		-Server
	}
	request_body {
		max_size 1MB
	}
	# Public 443 belongs to Apache, so the TLS-ALPN challenge can never reach Caddy; certificates
	# are issued over HTTP-01, which Apache forwards from port 80.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Proxy-Authorization delete
			resp_headers>Set-Cookie delete
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
		}
	}
}

{$TD_APP_HOSTNAME} {
	import common
	@internal path /healthz* /metrics* /internal/* /docs* /redoc* /openapi.json
	handle @internal {
		respond 404
	}
	handle {
		# One address only: the app counts the rightmost X-Forwarded-For entry, which would
		# otherwise be the Docker gateway for every visitor (login throttling would be global).
		reverse_proxy app:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

{$TD_GRAFANA_HOSTNAME} {
	import common
	@internal path /metrics* /api/health*
	handle @internal {
		respond 404
	}
	handle {
		reverse_proxy grafana:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
