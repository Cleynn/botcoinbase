# TradingDots environment template. PLACEHOLDERS ONLY: never commit a real .env.
# Create the real file with scripts/bootstrap.sh (generates random secrets locally, mode 0600).
# The production validator (make verify-security-config) FAILS while any CHANGE_ME value remains.

TD_ENVIRONMENT=production
TD_DEBUG=false
TD_PROFILE=backtest

TD_APP_HOSTNAME=tradingdots.onthewall.ovh
TD_GRAFANA_HOSTNAME=grafana.tradingdots.onthewall.ovh

TD_SECRET_KEY=CHANGE_ME_generate_with_bootstrap
POSTGRES_PASSWORD=CHANGE_ME_generate_with_bootstrap
REDIS_PASSWORD=CHANGE_ME_generate_with_bootstrap
TD_DB_APP_PASSWORD=CHANGE_ME_generate_with_bootstrap
TD_DB_CTL_PASSWORD=CHANGE_ME_generate_with_bootstrap
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_with_bootstrap
GRAFANA_SECRET_KEY=CHANGE_ME_generate_with_bootstrap
